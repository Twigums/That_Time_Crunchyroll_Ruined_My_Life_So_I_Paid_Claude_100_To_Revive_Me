[Unit]
Description=lydarr: anime tracker and web UI
After=network-online.target
Wants=network-online.target
# Give up after a few failed starts instead of retrying forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# %h is your home directory. Change both paths if the repository lives elsewhere.
WorkingDirectory=%h/git/lydarr-py
ExecStart=%h/git/lydarr-py/.venv/bin/python -m lydarr
Restart=on-failure
RestartSec=10
# Optional: settings here override the .env file in the repository.
EnvironmentFile=-%h/.config/lydarr/env

[Install]
WantedBy=default.target
