# Copy to .env in the repository root and uncomment what you need.
# lydarr reads .env on start; real environment variables take precedence over it.

# ── Files ────────────────────────────────────────────────────────────────────

# The watchlist. Use an absolute path when running as a service.
#ANIME_FILE=anime.toml

# Where lydarr remembers what it downloaded, and its AniList cache.
# Both default to the folder that holds the watchlist.
#LYDARR_STATE_FILE=/path/to/lydarr-state.json
#LYDARR_CACHE_FILE=/path/to/lydarr-cache.json

# Also write logs to this file (rotated at 5 MB, three old files kept).
#LYDARR_LOG_FILE=/path/to/lydarr.log

# ── Downloads ────────────────────────────────────────────────────────────────

# Root download folder. Each show gets a subfolder unless it sets its own save path.
#LYDARR_DEFAULT_DIR=/home/user/Downloads

# ── Transmission ─────────────────────────────────────────────────────────────

#TRANSMISSION_URL=http://localhost:9091/transmission/rpc
#TRANSMISSION_USER=
#TRANSMISSION_PASS=

# The systemd unit the Start/Stop controls act on, and whether it is a
# user unit ("user": systemctl --user) or a system unit ("system": sudo -n systemctl).
#LYDARR_TRANSMISSION_UNIT=transmission-daemon
#LYDARR_TRANSMISSION_SCOPE=user

# ── Jellyfin ─────────────────────────────────────────────────────────────────

# Have Jellyfin scan each finished download in, and check that the episode shows
# up. Leave JELLYFIN_URL unset to skip this. Create the key in Jellyfin under
# Dashboard -> API Keys.
#JELLYFIN_URL=http://localhost:8096
#JELLYFIN_API_KEY=

# Only needed when Jellyfin sees the downloads under another path and lydarr
# cannot line the folders up by name: "lydarr path=Jellyfin path", several
# pairs separated by ";".
#JELLYFIN_PATH_MAP=/home/user/media=/media

# ── Choosing a release ───────────────────────────────────────────────────────

# Hours to wait for a show's listed uploaders before accepting anyone else.
#LYDARR_FALLBACK_HOURS=2

# Prefer HEVC/x265 releases, and how many hours to hold out for one before
# taking a non-HEVC release. Set LYDARR_PREFER_HEVC=0 to take the best release at once.
#LYDARR_PREFER_HEVC=1
#LYDARR_HEVC_WAIT_HOURS=2

# Preferred vertical resolution.
#LYDARR_RESOLUTION=1080

# ── Web UI ───────────────────────────────────────────────────────────────────

#LYDARR_WEB_HOST=0.0.0.0
#LYDARR_WEB_PORT=8080

# HTTP Basic Auth. Leave unset only on a network you trust: anyone who can reach
# the page can add torrents and change save paths.
#LYDARR_USER=admin
#LYDARR_PASS=changeme
